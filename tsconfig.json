{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "assets/*": [
        "src/assets/*"
      ],
      "components/*": [
        "src/components/*"
      ],
      "context/*": [
        "src/context/*"
      ],
      "constants/*": [
        "src/constants/*"
      ],
      "hooks/*": [
        "src/hooks/*"
      ],
      "schema/*": [
        "src/schema/*"
      ],
      "schemaUI/*": [
        "src/schemaUI/*"
      ],
      "utils/*": [
        "src/utils/*"
      ],
      "theme/*": [
        "src/theme/*"
      ],
      "types/*": [
        "src/types/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "babel.config.ts"
  ]
}